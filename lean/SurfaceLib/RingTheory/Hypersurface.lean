import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.KrullDimension.Regular
import Mathlib.RingTheory.Ideal.Cotangent
import Mathlib.RingTheory.Derivation.Basic
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.Algebra.MvPolynomial.PDeriv

/-! # Regularity of hypersurfaces

A quotient of a regular local domain by an element of `𝔪 \ 𝔪²` is regular. An element of a
prime `Q` whose image under some derivation lies outside `Q` is not in `(Q R_Q)²`.
-/

namespace SurfaceLib

open IsLocalRing

section Quotient

variable {A : Type*} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]

/-- Generators of `𝔪` consisting of `h` and at most `dim 𝔪/𝔪² - 1` further elements. -/
theorem exists_generators_with (h : A) (hm : h ∈ maximalIdeal A) (hm2 : h ∉ maximalIdeal A ^ 2) :
    ∃ s : Finset A, (s : Set A) ⊆ maximalIdeal A ∧
      s.card + 1 ≤ Module.finrank (ResidueField A) (CotangentSpace A) ∧
      Ideal.span (insert h (s : Set A)) = maximalIdeal A := by
  classical
  set τ := (maximalIdeal A).toCotangent
  have hτ : τ ⟨h, hm⟩ ≠ 0 := by
    rw [Ne, Ideal.toCotangent_eq_zero]
    exact hm2
  set U : Submodule (ResidueField A) (CotangentSpace A) := (ResidueField A) ∙ τ ⟨h, hm⟩
  have hU : Module.finrank (ResidueField A) U = 1 := finrank_span_singleton hτ
  have hW : Module.finrank (ResidueField A) (CotangentSpace A ⧸ U) + 1 =
      Module.finrank (ResidueField A) (CotangentSpace A) := by
    rw [← hU]
    exact Submodule.finrank_quotient_add_finrank U
  let b := Module.finBasis (ResidueField A) (CotangentSpace A ⧸ U)
  have hsurj : Function.Surjective (fun z : maximalIdeal A ↦ U.mkQ (τ z)) :=
    (Submodule.mkQ_surjective U).comp (Ideal.toCotangent_surjective _)
  choose g hg using fun j ↦ hsurj (b j)
  let s : Finset A := Finset.univ.image fun j ↦ (g j : A)
  refine ⟨s, ?_, ?_, ?_⟩
  · intro a ha
    simp only [s, Finset.coe_image, Finset.coe_univ, Set.image_univ, Set.mem_range] at ha
    obtain ⟨j, rfl⟩ := ha
    exact (g j).2
  · have : s.card ≤ Module.finrank (ResidueField A) (CotangentSpace A ⧸ U) :=
      Finset.card_image_le.trans (by simp)
    omega
  · set X : Set (maximalIdeal A) := insert ⟨h, hm⟩ (Set.range g)
    have hT : Submodule.span (ResidueField A) (τ '' X) = ⊤ := by
      set T := Submodule.span (ResidueField A) (τ '' X)
      have hUT : U ≤ T := Submodule.span_mono (by
        rintro _ rfl
        exact ⟨⟨h, hm⟩, Set.mem_insert _ _, rfl⟩)
      have hmap : T.map U.mkQ = ⊤ := by
        rw [eq_top_iff, ← b.span_eq, Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        rw [← hg j]
        exact Submodule.mem_map_of_mem (Submodule.subset_span ⟨g j, Set.mem_insert_of_mem _ ⟨j, rfl⟩, rfl⟩)
      have := congrArg (Submodule.comap U.mkQ) hmap
      rwa [Submodule.comap_map_mkQ, sup_eq_right.mpr hUT, Submodule.comap_top] at this
    have hX : Submodule.span A X = ⊤ := (CotangentSpace.span_image_eq_top_iff).mp hT
    have := congrArg (Submodule.map (maximalIdeal A).subtype) hX
    rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at this
    rw [← this]
    congr 1
    ext a
    simp only [X, Set.image_insert_eq, Submodule.coe_subtype, Set.mem_insert_iff,
      Set.mem_image, Set.mem_range, s, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    constructor
    · rintro (rfl | ⟨j, rfl⟩)
      · exact Or.inl rfl
      · exact Or.inr ⟨g j, ⟨j, rfl⟩, rfl⟩
    · rintro (rfl | ⟨_, ⟨j, rfl⟩, rfl⟩)
      · exact Or.inl rfl
      · exact Or.inr ⟨j, rfl⟩


/-- A surjective image of a regular local domain with kernel generated by an element of
`𝔪 \ 𝔪²` is a regular local ring. -/
theorem isRegularLocalRing_of_surjective {A A' : Type*} [CommRing A] [CommRing A']
    [IsRegularLocalRing A] [IsDomain A] (φ : A →+* A') (hφ : Function.Surjective φ) {h : A}
    (hker : RingHom.ker φ = Ideal.span {h}) (hm : h ∈ maximalIdeal A)
    (hm2 : h ∉ maximalIdeal A ^ 2) : IsRegularLocalRing A' := by
  have hφh : φ h = 0 := by
    rw [← RingHom.mem_ker, hker]; exact Ideal.mem_span_singleton_self h
  have hle : Ideal.span {h} ≤ maximalIdeal A := (Ideal.span_singleton_le_iff_mem _).mpr hm
  have : Nontrivial A' := by
    refine nontrivial_of_ne (φ 1) 0 fun h1 ↦ ?_
    have h1' : (1 : A) ∈ maximalIdeal A := hle (hker ▸ (RingHom.mem_ker.mpr h1))
    exact (maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h1')
  have : IsLocalRing A' := .of_surjective' φ hφ
  have : IsNoetherianRing A' := isNoetherianRing_of_surjective A A' φ hφ
  obtain ⟨s, -, hcard, hspan⟩ := exists_generators_with h hm hm2
  have hmax : maximalIdeal A' = Ideal.span (φ '' (s : Set A)) := by
    rw [← map_maximalIdeal_of_surjective φ hφ, ← hspan, Ideal.map_span, Set.image_insert_eq, hφh,
      Ideal.span_insert_zero]
  have h1 : (maximalIdeal A').spanFinrank ≤ s.card := by
    rw [hmax]
    calc (Ideal.span (φ '' (s : Set A))).spanFinrank ≤ (φ '' (s : Set A)).ncard :=
          Submodule.spanFinrank_span_le_ncard_of_finite (s.finite_toSet.image _)
      _ ≤ (s : Set A).ncard := Set.ncard_image_le s.finite_toSet
      _ = s.card := Set.ncard_coe_finset s
  have hdim : ringKrullDim A' + 1 = ringKrullDim A := by
    have hh0 : h ≠ 0 := by rintro rfl; exact hm2 (zero_mem _)
    rw [← ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hφ), hker]
    exact ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      (mem_nonZeroDivisors_of_ne_zero hh0) hm
  have hreg : ((maximalIdeal A).spanFinrank : WithBot ℕ∞) = ringKrullDim A :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace, ← hdim] at hreg
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  induction hd : ringKrullDim A' using WithBot.recBotCoe with
  | bot => rw [hd] at hreg; simp at hreg
  | coe e =>
    induction e using ENat.recTopCoe with
    | top =>
      rw [hd] at hreg
      refine absurd hreg ?_
      intro h
      have h' : ((Module.finrank (ResidueField A) (CotangentSpace A) : ℕ∞) : WithBot ℕ∞) =
          ((⊤ + 1 : ℕ∞) : WithBot ℕ∞) := h
      exact ENat.natCast_ne_top _ ((WithBot.coe_injective h').trans (top_add 1))
    | coe m =>
      rw [hd] at hreg
      have hm' : Module.finrank (ResidueField A) (CotangentSpace A) = m + 1 := by
        exact_mod_cast hreg
      have : (maximalIdeal A').spanFinrank ≤ m := by omega
      exact_mod_cast this

end Quotient

section Derivation

variable {S R : Type*} [CommRing S] [CommRing R] [Algebra S R]

theorem derivation_mem_of_mem_sq (Q : Ideal R) (D : Derivation S R R) {z : R} (hz : z ∈ Q ^ 2) :
    D z ∈ Q := by
  rw [pow_two] at hz
  refine Submodule.mul_induction_on hz (fun a ha b hb ↦ ?_) (fun a b ha hb ↦ ?_)
  · rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact Q.add_mem (Q.mul_mem_right _ ha) (Q.mul_mem_right _ hb)
  · rw [map_add]
    exact Q.add_mem ha hb

/-- An element of a prime whose derivative lies outside it is not in `(Q R_Q)²`. -/
theorem algebraMap_not_mem_maximalIdeal_sq (Q : Ideal R) [Q.IsPrime] (D : Derivation S R R)
    {h : R} (hQ : h ∈ Q) (hD : D h ∉ Q) :
    algebraMap R (Localization.AtPrime Q) h ∉ maximalIdeal (Localization.AtPrime Q) ^ 2 := by
  intro hmem
  rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow,
    IsLocalization.mem_map_algebraMap_iff Q.primeCompl] at hmem
  obtain ⟨⟨⟨a, ha⟩, ⟨t, ht⟩⟩, he⟩ := hmem
  simp only at he
  rw [← map_mul, IsLocalization.eq_iff_exists Q.primeCompl] at he
  obtain ⟨⟨u, hu⟩, hu'⟩ := he
  simp only at hu'
  -- `(u t) h = u a ∈ Q²`
  have hmem : (u * t) * h ∈ Q ^ 2 := by
    have : (u * t) * h = u * a := by rw [← hu']; ring
    rw [this]
    exact Ideal.mul_mem_left _ _ ha
  have h1 := derivation_mem_of_mem_sq Q D hmem
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul] at h1
  have h2 : (u * t) * D h ∈ Q := by
    have := Q.sub_mem h1 (Q.mul_mem_right (D (u * t)) hQ)
    simpa [mul_comm] using this
  rcases Ideal.IsPrime.mem_or_mem inferInstance h2 with h3 | h3
  · rcases Ideal.IsPrime.mem_or_mem inferInstance h3 with h4 | h4
    · exact hu h4
    · exact ht h4
  · exact hD h3

end Derivation


section ChainRule

variable {R A M : Type*} [CommRing R] [CommRing A] [Algebra R A] [AddCommGroup M] [Module A M]
  [Module R M]

/-- The chain rule for a derivation applied to a polynomial expression. -/
theorem derivation_aeval (δ : Derivation R A M) {σ : Type*} [Fintype σ] [DecidableEq σ]
    (x : σ → A) (p : MvPolynomial σ R) :
    δ (MvPolynomial.aeval x p) = ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l p) • δ (x l) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    simp only [map_add, hp, hq, add_smul, Finset.sum_add_distrib]
  | mul_X p j hp =>
    have key (l : σ) : MvPolynomial.aeval x (MvPolynomial.pderiv l (p * MvPolynomial.X j)) =
        (if l = j then MvPolynomial.aeval x p else 0) +
          x j * MvPolynomial.aeval x (MvPolynomial.pderiv l p) := by
      rw [Derivation.leibniz, MvPolynomial.pderiv_X]
      by_cases h : l = j
      · subst h
        simp
      · simp [Ne.symm h, h]
    simp only [key, add_smul, Finset.sum_add_distrib, ite_smul, zero_smul, Finset.sum_ite_eq',
      Finset.mem_univ, ite_true]
    rw [map_mul, MvPolynomial.aeval_X, Derivation.leibniz, hp, Finset.smul_sum]
    simp only [smul_smul]

end ChainRule

end SurfaceLib

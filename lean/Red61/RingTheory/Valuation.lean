/-! # Prime orders and weighted filtrations

Formerly the modules `AtPrimeValuation`, `PrimeOrder`, `WeightedFiltration`.
-/

/-! Centered valuations on a chart extend to its prime localization, with
value zero precisely on the units of that local ring. -/

namespace Red61

noncomputable section

variable (A F : Type*) [CommRing A] [IsDomain A] [Field F] [Algebra A F]
  [IsFractionRing A F] (p : PrimeSpectrum A)

theorem atPrime_denominator_unit (s : p.asIdeal.primeCompl) : IsUnit (algebraMap A F s) := by
  apply isUnit_iff_ne_zero.mpr
  exact IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors
    (p.asIdeal.primeCompl_le_nonZeroDivisors s.property)

def atPrimeEmbedding : Localization.AtPrime p.asIdeal →+* F :=
  IsLocalization.lift (atPrime_denominator_unit A F p)

@[simp] theorem atPrimeEmbedding_algebraMap (a : A) :
    atPrimeEmbedding A F p (algebraMap A (Localization.AtPrime p.asIdeal) a) = algebraMap A F a :=
  IsLocalization.lift_eq _ _

@[simp] theorem atPrimeEmbedding_mk (a : A) (b : p.asIdeal.primeCompl) :
    atPrimeEmbedding A F p (IsLocalization.mk' _ a b) = algebraMap A F a / algebraMap A F b := by
  apply (IsLocalization.lift_mk'_spec (atPrime_denominator_unit A F p) a _ b).mpr
  field_simp [(isUnit_iff_ne_zero.mp (atPrime_denominator_unit A F p b))]

variable (v : AddValuation F (WithTop ℤ))
  (hn : ∀ a : A, 0 ≤ v (algebraMap A F a))
  (hc : ∀ a : A, 0 < v (algebraMap A F a) ↔ a ∈ p.asIdeal)

include hn hc

end
end Red61

namespace Red61

noncomputable section
variable {R : Type*} [CommRing R] [IsDomain R] [WfDvdMonoid R] {p : R}

/-- Integer-valued order at a prime element, with infinity at zero. -/
def primeOrder (hp : Prime p) : AddValuation R (WithTop ℤ) :=
  (multiplicity_addValuation hp).map (Nat.castAddMonoidHom ℤ).ENatMap
    rfl ENat.map_natCast_strictMono.monotone

omit [WfDvdMonoid R] in
@[simp] theorem primeOrder_apply (hp : Prime p) (x : R) :
    primeOrder hp x = ENat.map (Nat.cast : ℕ → ℤ) (emultiplicity p x) := rfl

theorem primeOrder_ne_top (hp : Prime p) (x : R) (hx : x ≠ 0) : primeOrder hp x ≠ ⊤ := by
  intro h
  have htop : emultiplicity p x = ⊤ := ENat.map_eq_top_iff.mp h
  exact (finiteMultiplicity_iff_emultiplicity_ne_top.mp
    (FiniteMultiplicity.of_prime_left hp hx)) htop

theorem primeOrder_denominators (hp : Prime p) :
    nonZeroDivisors R ≤ (primeOrder hp).toValuation.supp.primeCompl := by
  intro x hx
  change primeOrder hp x ≠ ⊤
  exact primeOrder_ne_top hp x (nonZeroDivisors.ne_zero hx)

/-- Extension to the fraction field uses the localization universal property. -/
def fractionPrimeOrder (hp : Prime p) : AddValuation (FractionRing R) (WithTop ℤ) :=
  AddValuation.ofValuation
    ((primeOrder hp).toValuation.extendToLocalization (primeOrder_denominators hp) (FractionRing R))

@[simp] theorem fractionPrimeOrder_algebraMap (hp : Prime p) (x : R) :
    fractionPrimeOrder hp (algebraMap R (FractionRing R) x) = primeOrder hp x := by
  exact Valuation.extendToLocalization_apply_map_apply (primeOrder hp).toValuation
    (primeOrder_denominators hp) (FractionRing R) x

omit [WfDvdMonoid R] in
theorem primeOrder_self (hp : Prime p) : primeOrder hp p = 1 := by
  have h := emultiplicity_pow_self_of_prime hp 1
  simpa [primeOrder_apply] using congrArg (ENat.map (Nat.cast : ℕ → ℤ)) h

omit [WfDvdMonoid R] in
theorem primeOrder_of_not_dvd (hp : Prime p) {x : R} (h : ¬p ∣ x) : primeOrder hp x = 0 := by
  rw [primeOrder_apply, emultiplicity_eq_zero.mpr h]
  rfl

end
end Red61

namespace Red61.WeightedFiltration

open MvPolynomial
noncomputable section
variable {A k F : Type*} [CommRing A] [Field k] [Field F] [Algebra k F]

abbrev Exponent := Fin 2 →₀ ℕ
def weight (a b : ℕ) (d : Exponent) : ℕ := a * d 0 + b * d 1
def term (u r : A) (d : Exponent) : A := u ^ d 0 * r ^ d 1
/-- The ideal generated by parameter monomials of weight at least n. -/
def monomialIdeal (u r : A) (a b n : ℕ) : Ideal A :=
  Ideal.span {x | ∃ d : Exponent, n ≤ weight a b d ∧ x = term u r d}

end
end Red61.WeightedFiltration

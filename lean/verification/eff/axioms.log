Eff.quotient_properties :
  AlgebraicGeometry.IsProper Eff.yToBase ∧
    AlgebraicGeometry.IsIntegral Eff.Y ∧
      AlgebraicGeometry.IsNoetherian Eff.Y ∧
        topologicalKrullDim ↥Eff.Y = 2 ∧
          AlgebraicGeometry.IsFinite Eff.rho ∧
            AlgebraicGeometry.Surjective Eff.rho ∧
              CategoryTheory.CategoryStruct.comp Eff.rho Eff.yToBase = Red61.Contraction.sToBase ∧
                Function.Bijective ⇑(Red61.globalScalarMap (↥Red61.Fields.ell) Eff.yToBase)
Eff.Canonical.canonicalSheaf_trivial (adjunction : SurfaceLib.Canonical.ClassicalAdjunction)
  (K : Red61.Contraction.S.Modules)
  (DK : SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Red61.Contraction.sToBase 2 K) :
  Nonempty (K ≅ Red61.structureSheafModule Red61.Contraction.S)

  ∀ (K : Eff.Y.Modules) (DK : SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Eff.yToBase 2 K) (n : ℕ),
    Nonempty (SurfaceLib.LineBundle.tensorPower K n ≅ Red61.structureSheafModule Eff.Y) ↔ 5 ∣ n
Eff.canonicalSheaf_order_five : SurfaceLib.Canonical.ClassicalAdjunction →
  ∀ (K : Eff.Y.Modules) (DK : SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Eff.yToBase 2 K),
    Nonempty (SurfaceLib.LineBundle.tensorPower K 5 ≅ Red61.structureSheafModule Eff.Y) ∧

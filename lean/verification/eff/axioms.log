def Eff.IsNormalScheme.{u_1} : CategoryTheory.ObjectProperty AlgebraicGeometry.Scheme :=
fun X => ∀ (x : ↥X), IsDomain ↑(X.presheaf.stalk x) ∧ IsIntegrallyClosed ↑(X.presheaf.stalk x)
def SurfaceLib.Projective.IsProjectiveOver : (R : Type) →
  [inst : Field R] → {X : AlgebraicGeometry.Scheme} → (X ⟶ AlgebraicGeometry.Spec ↧R) → Prop :=
fun R [Field R] {X} f =>
  ∃ A x x_1 𝒜 x_2 e,
    Algebra.FiniteType R A ∧
      Function.Bijective ⇑(algebraMap R ↥(𝒜 0)) ∧
        CategoryTheory.CategoryStruct.comp e.hom (SurfaceLib.Projective.projBase 𝒜) = f
def SurfaceLib.Abelian.IsParaAbelianVariety : (F : Type) →
  [inst : Field F] → {P : AlgebraicGeometry.Scheme} → (P ⟶ AlgebraicGeometry.Spec ↧F) → Prop :=
fun F [Field F] {P} π =>
  AlgebraicGeometry.IsProper π ∧
    ∃ G x fst,
      AlgebraicGeometry.IsProper G.hom ∧
        AlgebraicGeometry.GeometricallyIntegral G.hom ∧
          CategoryTheory.IsPullback fst G.hom π
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))

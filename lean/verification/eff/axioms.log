Eff.y_example :
  Nonempty (FractionRing (MvPolynomial (Fin 2) (ZMod 5)) ≃+* ↥Red61.Fields.ell) ∧
    SurfaceLib.Projective.IsProjectiveOver (↥Red61.Fields.ell) Eff.yToBase ∧
      AlgebraicGeometry.IsProper Eff.yToBase ∧
        AlgebraicGeometry.IsIntegral Eff.Y ∧
          topologicalKrullDim ↥Eff.Y = 2 ∧
            (∀ (y : ↥Eff.Y), IsRegularLocalRing ↑(Eff.Y.presheaf.stalk y)) ∧
              Function.Bijective ⇑(Red61.globalScalarMap (↥Red61.Fields.ell) Eff.yToBase) ∧
                (∀ (n : ℕ),
                    Nonempty (SurfaceLib.LineBundle.tensorPower Eff.yOmega n ≅ Red61.structureSheafModule Eff.Y) ↔
                      5 ∣ n) ∧
                  ¬AlgebraicGeometry.geometrically Eff.IsNormalScheme Eff.yToBase

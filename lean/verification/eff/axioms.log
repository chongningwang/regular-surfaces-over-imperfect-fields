    (∃ K, Nonempty (SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Eff.yToBase 2 K)) ∧
      (∀ (K : Eff.Y.Modules) (x : SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Eff.yToBase 2 K) (n : ℕ),
          Nonempty (SurfaceLib.LineBundle.tensorPower K n ≅ Red61.structureSheafModule Eff.Y) ↔ 5 ∣ n) ∧
        SurfaceLib.Abelian.IsAlbaneseMorphism Eff.yToBase
          (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec ↧↥Red61.Fields.ell)) Eff.yToBase
Eff.s_example :
  Nonempty (FractionRing (MvPolynomial (Fin 2) (ZMod 5)) ≃+* ↥Red61.Fields.ell) ∧
    SurfaceLib.Projective.IsProjectiveOver (↥Red61.Fields.ell) Red61.Contraction.sToBase ∧

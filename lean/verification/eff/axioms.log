                ¬AlgebraicGeometry.GeometricallyReduced Red61.Contraction.sToBase
Eff.theorem_6_1 : SurfaceLib.Canonical.ClassicalAdjunction →
  (∃ K, Nonempty (SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Red61.Contraction.sToBase 2 K)) ∧
    ∀ (K : Red61.Contraction.S.Modules)
      (x : SurfaceLib.Canonical.TopDuality (↥Red61.Fields.ell) Red61.Contraction.sToBase 2 K),

import Geonormal.P11.Dimension
import SurfaceLib.RingTheory.Hypersurface
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.RingTheory.MvPolynomial.Tower
import Mathlib.RingTheory.RegularLocalRing.Polynomial

/-! # The local rings of the charts `A`, `B`, `D` are regular

Over `𝔽₁₁` the charts are hypersurfaces in `𝔽₁₁[Y, x₁, x₂, x₃]`, after inverting the nonzero
polynomials in `c`:

| chart | `x₁, x₂, x₃` | `Y` | equation |
|---|---|---|---|
| `A` | `a, b, σ` | `0` | `Y` |
| `B` | `u, α, ρ` | `β` | `Y² - (α + uα⁴)` |
| `D` | `w, α″, ρ` | `β″` | `Y² - (α″ + w¹¹α″⁴)` |

The coordinates `x₁, x₂, x₃` are algebraically independent over `𝔽₁₁`, and `1, Y` are independent
over `𝔽₁₁[x₁, x₂, x₃]`, since `α + uα⁴` has odd degree in `u` and `α″ + w¹¹α″⁴` has odd degree
in `w`. So the kernel of the presentation is generated by the equation. The equation and its
partial derivatives generate the unit ideal, so the equation lies outside the square of the
maximal ideal at every prime.
-/

namespace Geonormal.P11

open Red61 Red61.AffineGluing AlgebraicGeometry IsLocalRing MvPolynomial

noncomputable section

/-! ## Coordinates over `𝔽₁₁` -/

theorem three_le_trdeg_L : (3 : Cardinal) ≤ Algebra.trdeg F₁₁ L := by
  have h := (MvPolynomial.algebraicIndependent_X (Fin 3) F₁₁).map'
    (f := IsScalarTower.toAlgHom F₁₁ P₃ L) (IsFractionRing.injective P₃ L)
  simpa using h.cardinalMk_le_trdeg

theorem L_generation (N : IntermediateField F₁₁ L) (ha : aL ∈ N) (hb : bL ∈ N) (hs : σL ∈ N) :
    N = ⊤ := by
  have hR (p : P₃) : algebraMap P₃ L p ∈ N := by
    induction p using MvPolynomial.induction_on with
    | C r =>
      rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
      exact N.algebraMap_mem r
    | add p q hp hq => simpa only [map_add] using N.add_mem hp hq
    | mul_X p j hp =>
      rw [map_mul]
      refine N.mul_mem hp ?_
      fin_cases j
      · exact ha
      · exact hb
      · exact hs
  rw [eq_top_iff]
  intro z _
  obtain ⟨u, v, -, rfl⟩ := IsFractionRing.div_surjective (A := P₃) z
  exact N.div_mem (hR u) (hR v)

theorem isIntegral_of_mem_field {M : IntermediateField F₁₁ L} {z : L} (hz : z ∈ M) :
    IsIntegral M z :=
  isIntegral_algebraMap (x := (⟨z, hz⟩ : M))

theorem isIntegral_of_sq_mem {M : IntermediateField F₁₁ L} {z : L} (hz : z ^ 2 ∈ M) :
    IsIntegral M z :=
  ⟨Polynomial.X ^ 2 - Polynomial.C ⟨_, hz⟩, Polynomial.monic_X_pow_sub_C _ (by norm_num),
    by simp⟩

/-- `L` is algebraic over the field generated by `v` when `a, b, σ` are integral over it. -/
theorem algebraic_of_integral (v : Fin 3 → L)
    (h : ∀ M : IntermediateField F₁₁ L, (∀ j, v j ∈ M) →
      IsIntegral M aL ∧ IsIntegral M bL ∧ IsIntegral M σL) :
    Algebra.IsAlgebraic (Algebra.adjoin F₁₁ (Set.range v)) L := by
  rw [← IntermediateField.isAlgebraic_adjoin_iff_top]
  set M := IntermediateField.adjoin F₁₁ (Set.range v)
  obtain ⟨ha, hb, hs⟩ := h M fun j ↦ IntermediateField.subset_adjoin _ _ ⟨j, rfl⟩
  have htop : IntermediateField.adjoin M {aL, bL, σL} = ⊤ := by
    apply IntermediateField.restrictScalars_injective F₁₁
    rw [IntermediateField.adjoin_adjoin_left, IntermediateField.restrictScalars_top]
    exact L_generation _ (IntermediateField.subset_adjoin _ _ (by simp))
      (IntermediateField.subset_adjoin _ _ (by simp)) (IntermediateField.subset_adjoin _ _ (by simp))
  have : FiniteDimensional M (IntermediateField.adjoin M {aL, bL, σL}) :=
    IntermediateField.finiteDimensional_adjoin (by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl
      · exact ha
      · exact hb
      · exact hs)
  rw [htop] at this
  have : FiniteDimensional M L := IntermediateField.topEquiv.toLinearEquiv.finiteDimensional
  exact Algebra.IsAlgebraic.of_finite M L

theorem coord_independent_A : AlgebraicIndependent F₁₁ ![aL, bL, σL] := by
  have h := (MvPolynomial.algebraicIndependent_X (Fin 3) F₁₁).map'
    (f := IsScalarTower.toAlgHom F₁₁ P₃ L) (IsFractionRing.injective P₃ L)
  convert h using 1
  funext j
  fin_cases j <;> rfl

theorem coord_independent_B : AlgebraicIndependent F₁₁ ![uL, αL, ρL] := by
  have : Algebra.IsAlgebraic (Algebra.adjoin F₁₁ (Set.range ![uL, αL, ρL])) L := by
    apply algebraic_of_integral
    intro M hv
    have hu : uL ∈ M := hv 0
    have hα : αL ∈ M := hv 1
    have hρ : ρL ∈ M := hv 2
    have ha0 := aL_ne_zero
    have ha : aL ∈ M := by
      rw [show aL = αL⁻¹ by simp [αL]]
      exact M.inv_mem hα
    have hb : IsIntegral M bL := by
      refine isIntegral_of_sq_mem ?_
      rw [show bL ^ 2 = aL ^ 3 + uL by simp [uL]]
      exact M.add_mem (M.pow_mem ha 3) hu
    refine ⟨isIntegral_of_mem_field ha, hb, ?_⟩
    rw [show σL = ρL - (bL + bL) * αL by simp only [ρL, αL]; field_simp <;> ring]
    exact (isIntegral_of_mem_field hρ).sub ((hb.add hb).mul (isIntegral_of_mem_field hα))
  exact (Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite F₁₁ ![uL, αL, ρL]
    (by simpa using three_le_trdeg_L)).1

theorem coord_independent_D : AlgebraicIndependent F₁₁ ![wL, αD, ρL] := by
  have : Algebra.IsAlgebraic (Algebra.adjoin F₁₁ (Set.range ![wL, αD, ρL])) L := by
    apply algebraic_of_integral
    intro M hv
    have hw : wL ∈ M := hv 0
    have hα : αD ∈ M := hv 1
    have hρ : ρL ∈ M := hv 2
    have ha0 := aL_ne_zero
    have hu0 := uL_ne_zero
    have hu : uL ∈ M := by
      rw [show uL = wL⁻¹ by simp [wL]]
      exact M.inv_mem hw
    have ha : aL ∈ M := by
      rw [show aL = uL ^ 4 * αD⁻¹ by simp only [αD]; field_simp]
      exact M.mul_mem (M.pow_mem hu 4) (M.inv_mem hα)
    have hb : IsIntegral M bL := by
      refine isIntegral_of_sq_mem ?_
      rw [show bL ^ 2 = aL ^ 3 + uL by simp [uL]]
      exact M.add_mem (M.pow_mem ha 3) hu
    refine ⟨isIntegral_of_mem_field ha, hb, ?_⟩
    rw [show σL = ρL - (bL + bL) * aL⁻¹ by simp only [ρL]; field_simp <;> ring]
    exact (isIntegral_of_mem_field hρ).sub ((hb.add hb).mul (isIntegral_of_mem_field (M.inv_mem ha)))
  exact (Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite F₁₁ ![wL, αD, ρL]
    (by simpa using three_le_trdeg_L)).1

/-! ## The presentations -/

/-- The ambient polynomial ring `𝔽₁₁[Y, x₁, x₂, x₃]`. -/
abbrev P₄ := MvPolynomial (Fin 4) F₁₁

/-- The coordinates `x₁, x₂, x₃` of the charts `A, B, D`. -/
def coordV : Fin 3 → Fin 3 → L := ![![aL, bL, σL], ![uL, αL, ρL], ![wL, αD, ρL]]

/-- The value of `Y`: `0` on `A`, `β` on `B`, `β″` on `D`. -/
def yV : Fin 3 → L := ![0, βL, βD]

theorem coord_independent (i : Fin 3) : AlgebraicIndependent F₁₁ (coordV i) := by
  fin_cases i
  exacts [coord_independent_A, coord_independent_B, coord_independent_D]

def coeffEval (i : Fin 3) : P₃ →ₐ[F₁₁] L := aeval (coordV i)

theorem coeffEval_injective (i : Fin 3) : Function.Injective (coeffEval i) :=
  algebraicIndependent_iff_injective_aeval.mp (coord_independent i)

def chartVals (i : Fin 3) : Fin 4 → L := Fin.cons (yV i) (coordV i)

@[simp] theorem chartVals_zero (i : Fin 3) : chartVals i 0 = yV i := rfl
@[simp] theorem chartVals_one (i : Fin 3) : chartVals i 1 = coordV i 0 := rfl
@[simp] theorem chartVals_two (i : Fin 3) : chartVals i 2 = coordV i 1 := rfl
@[simp] theorem chartVals_three (i : Fin 3) : chartVals i 3 = coordV i 2 := rfl

def chartEval (i : Fin 3) : P₄ →ₐ[F₁₁] L := aeval (chartVals i)

theorem chartEval_eq_eval₂ (i : Fin 3) (p : P₄) :
    chartEval i p = Polynomial.eval₂ (coeffEval i).toRingHom (yV i) (finSuccEquiv F₁₁ 3 p) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    have h := (finSuccEquiv F₁₁ 3).commutes a
    rw [MvPolynomial.algebraMap_eq] at h
    rw [h, Polynomial.algebraMap_apply, Polynomial.eval₂_C, chartEval, aeval_C]
    simp [coeffEval]
  | add p q hp hq => rw [map_add, map_add, Polynomial.eval₂_add, hp, hq]
  | mul_X p j hp =>
    rw [map_mul, map_mul, Polynomial.eval₂_mul, hp]
    congr 1
    refine Fin.cases ?_ (fun j ↦ ?_) j
    · rw [finSuccEquiv_X_zero, Polynomial.eval₂_X]
      simp [chartEval, chartVals]
    · rw [finSuccEquiv_X_succ, Polynomial.eval₂_C, chartEval, aeval_X]
      simp [coeffEval, chartVals]

/-- The chart equations. -/
def hPoly : Fin 3 → P₄ :=
  ![X 0, X 0 ^ 2 - (X 2 + X 1 * X 2 ^ 4), X 0 ^ 2 - (X 2 + X 1 ^ 11 * X 2 ^ 4)]

/-- `Y²` on the charts `B`, `D`, in the coordinates `x₁, x₂, x₃`. -/
def gPoly : Fin 3 → P₃ := ![0, X 1 + X 0 * X 1 ^ 4, X 1 + X 0 ^ 11 * X 1 ^ 4]

def Hpol : Fin 3 → Polynomial P₃ := ![Polynomial.X, Polynomial.X ^ 2 - Polynomial.C (gPoly 1),
  Polynomial.X ^ 2 - Polynomial.C (gPoly 2)]

theorem finSuccEquiv_X_one : finSuccEquiv F₁₁ 3 (X 1) = Polynomial.C (X 0) :=
  finSuccEquiv_X_succ (j := 0)
theorem finSuccEquiv_X_two : finSuccEquiv F₁₁ 3 (X 2) = Polynomial.C (X 1) :=
  finSuccEquiv_X_succ (j := 1)
theorem finSuccEquiv_X_three : finSuccEquiv F₁₁ 3 (X 3) = Polynomial.C (X 2) :=
  finSuccEquiv_X_succ (j := 2)

theorem finSuccEquiv_hPoly (i : Fin 3) : finSuccEquiv F₁₁ 3 (hPoly i) = Hpol i := by
  fin_cases i <;>
    simp [hPoly, Hpol, gPoly, finSuccEquiv_X_zero, finSuccEquiv_X_one, finSuccEquiv_X_two,
      finSuccEquiv_X_three]

theorem Hpol_monic (i : Fin 3) : (Hpol i).Monic := by
  fin_cases i
  · exact Polynomial.monic_X
  · exact Polynomial.monic_X_pow_sub_C _ (by norm_num)
  · exact Polynomial.monic_X_pow_sub_C _ (by norm_num)

theorem Hpol_ne_one (i : Fin 3) : Hpol i ≠ 1 := by
  intro h
  have := congrArg Polynomial.natDegree h
  fin_cases i <;> simp [Hpol, Polynomial.natDegree_X_pow_sub_C] at this

theorem chartEval_hPoly (i : Fin 3) : chartEval i (hPoly i) = 0 := by
  fin_cases i
  · simp [hPoly, chartEval, yV]
  · simp [hPoly, chartEval, yV, coordV, βL_sq]
  · simp [hPoly, chartEval, yV, coordV, βD_sq]

theorem yV_sq (i : Fin 3) (hi : i ≠ 0) : yV i ^ 2 = coeffEval i (gPoly i) := by
  fin_cases i
  · exact absurd rfl hi
  · simp [yV, coeffEval, gPoly, coordV, βL_sq]
  · simp [yV, coeffEval, gPoly, coordV, βD_sq]

theorem gPoly_ne_zero (i : Fin 3) (hi : i ≠ 0) : gPoly i ≠ 0 := by
  intro h
  have h2 := yV_sq i hi
  rw [h, map_zero] at h2
  fin_cases i
  · exact hi rfl
  · have : βL ≠ 0 := by
      simp only [βL]
      exact div_ne_zero bL_ne_zero (pow_ne_zero _ aL_ne_zero)
    exact this (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2)
  · have : βD ≠ 0 := by
      simp only [βD]
      exact div_ne_zero (mul_ne_zero (pow_ne_zero _ uL_ne_zero) bL_ne_zero)
        (pow_ne_zero _ aL_ne_zero)
    exact this (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp h2)

theorem degreeOf_gPoly (i : Fin 3) (hi : i ≠ 0) : Odd (degreeOf 0 (gPoly i)) := by
  have h1 : finSuccEquiv F₁₁ 2 (X 1) = Polynomial.C (X 0) := finSuccEquiv_X_succ (j := 0)
  have hX : (X 0 : MvPolynomial (Fin 2) F₁₁) ^ 4 ≠ 0 := pow_ne_zero _ (X_ne_zero 0)
  rw [← natDegree_finSuccEquiv]
  fin_cases i
  · exact absurd rfl hi
  · show Odd (finSuccEquiv F₁₁ 2 (X 1 + X 0 * X 1 ^ 4)).natDegree
    rw [map_add, map_mul, map_pow, h1, finSuccEquiv_X_zero,
      show Polynomial.C (X 0 : MvPolynomial (Fin 2) F₁₁) + Polynomial.X * Polynomial.C (X 0) ^ 4 =
      Polynomial.C (X 0 ^ 4) * Polynomial.X + Polynomial.C (X 0) by rw [map_pow]; ring,
      Polynomial.natDegree_linear hX]
    decide
  · show Odd (finSuccEquiv F₁₁ 2 (X 1 + X 0 ^ 11 * X 1 ^ 4)).natDegree
    rw [map_add, map_mul, map_pow, map_pow, h1, finSuccEquiv_X_zero,
      show Polynomial.C (X 0 : MvPolynomial (Fin 2) F₁₁) + Polynomial.X ^ 11 * Polynomial.C (X 0) ^ 4 =
      Polynomial.C (X 0 ^ 4) * Polynomial.X ^ 11 + Polynomial.C (X 0) by rw [map_pow]; ring,
      Polynomial.natDegree_add_eq_left_of_natDegree_lt]
    · rw [Polynomial.natDegree_C_mul_X_pow 11 _ hX]; decide
    · rw [Polynomial.natDegree_C, Polynomial.natDegree_C_mul_X_pow 11 _ hX]; norm_num

/-- `1, Y` are linearly independent over `𝔽₁₁[x₁, x₂, x₃]` on the charts `B`, `D`. -/
theorem quad_unique (i : Fin 3) (hi : i ≠ 0) (r₀ r₁ : P₃)
    (h : coeffEval i r₁ * yV i + coeffEval i r₀ = 0) : r₀ = 0 ∧ r₁ = 0 := by
  have hsq : coeffEval i (r₀ ^ 2) = coeffEval i (r₁ ^ 2 * gPoly i) := by
    rw [map_pow, map_mul, map_pow, ← yV_sq i hi, eq_neg_of_add_eq_zero_right h]
    ring
  have hpoly := coeffEval_injective i hsq
  have hg := gPoly_ne_zero i hi
  obtain ⟨m, hm⟩ := degreeOf_gPoly i hi
  by_cases h1 : r₁ = 0
  · subst h1
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, zero_mul,
      pow_eq_zero_iff] at hpoly
    exact ⟨hpoly, rfl⟩
  · exfalso
    have h0 : r₀ ≠ 0 := by
      rintro rfl
      rw [zero_pow two_ne_zero] at hpoly
      exact mul_ne_zero (pow_ne_zero 2 h1) hg hpoly.symm
    have hd := congrArg (degreeOf 0) hpoly
    rw [degreeOf_pow_eq 0 _ 2 h0, degreeOf_mul_eq (pow_ne_zero 2 h1) hg,
      degreeOf_pow_eq 0 _ 2 h1] at hd
    omega

theorem Hpol_natDegree (i : Fin 3) (hi : i ≠ 0) : (Hpol i).natDegree = 2 := by
  fin_cases i
  · exact absurd rfl hi
  · exact Polynomial.natDegree_X_pow_sub_C
  · exact Polynomial.natDegree_X_pow_sub_C

theorem rem_zero (i : Fin 3) (r : Polynomial P₃) (hr : r.natDegree < (Hpol i).natDegree)
    (hev : Polynomial.eval₂ (coeffEval i).toRingHom (yV i) r = 0) : r = 0 := by
  fin_cases i
  · change r.natDegree < (Polynomial.X : Polynomial P₃).natDegree at hr
    rw [Polynomial.natDegree_X] at hr
    have hr0 : r.natDegree = 0 := by omega
    change Polynomial.eval₂ (coeffEval 0).toRingHom 0 r = 0 at hev
    rw [Polynomial.eq_C_of_natDegree_eq_zero hr0, Polynomial.eval₂_C] at hev
    have hc : r.coeff 0 = 0 := coeffEval_injective 0 (by simpa using hev)
    rw [Polynomial.eq_C_of_natDegree_eq_zero hr0, hc, map_zero]
  all_goals
    have hr1 : r.natDegree ≤ 1 := by
      rw [Hpol_natDegree _ (by decide)] at hr
      omega
    rw [Polynomial.eq_X_add_C_of_natDegree_le_one hr1] at hev ⊢
    simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at hev
    obtain ⟨h0, h1⟩ := quad_unique _ (by decide) _ _ hev
    rw [h0, h1]
    simp

theorem ker_chartEval (i : Fin 3) : RingHom.ker (chartEval i) = Ideal.span {hPoly i} := by
  apply le_antisymm
  · intro p hp
    rw [RingHom.mem_ker] at hp
    set φ := finSuccEquiv F₁₁ 3
    have hdecomp := Polynomial.modByMonic_add_div (φ p) (Hpol i)
    have h2 : Polynomial.eval₂ (coeffEval i).toRingHom (yV i) (Hpol i) = 0 := by
      rw [← finSuccEquiv_hPoly, ← chartEval_eq_eval₂]
      exact chartEval_hPoly i
    have hev : Polynomial.eval₂ (coeffEval i).toRingHom (yV i) (φ p %ₘ Hpol i) = 0 := by
      have h1 : Polynomial.eval₂ (coeffEval i).toRingHom (yV i) (φ p) = 0 :=
        (chartEval_eq_eval₂ i p) ▸ hp
      rw [← hdecomp, Polynomial.eval₂_add, Polynomial.eval₂_mul, h2, zero_mul, add_zero] at h1
      exact h1
    have hrz : φ p %ₘ Hpol i = 0 :=
      rem_zero i _ (Polynomial.natDegree_modByMonic_lt _ (Hpol_monic i) (Hpol_ne_one i)) hev
    rw [Ideal.mem_span_singleton]
    refine ⟨φ.symm (φ p /ₘ Hpol i), ?_⟩
    apply φ.injective
    rw [map_mul, φ.apply_symm_apply, finSuccEquiv_hPoly]
    rw [hrz, zero_add] at hdecomp
    exact hdecomp.symm
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact chartEval_hPoly i

/-! ## Jacobian certificates -/

theorem h11 : (11 : P₄) = 0 := by
  have : ((11 : ℕ) : P₄) = 0 := by
    rw [← map_natCast (algebraMap F₁₁ P₄), ZMod.natCast_self, map_zero]
  exact_mod_cast this

/-- The equation and its partial derivatives generate the unit ideal. -/
theorem one_mem_of_pderiv (i : Fin 3) (Q : Ideal P₄) (hh : hPoly i ∈ Q)
    (hd : ∀ j : Fin 4, pderiv j (hPoly i) ∈ Q) : (1 : P₄) ∈ Q := by
  have h0 := hd 0
  have h1 := hd 1
  have h2 := hd 2
  fin_cases i
  · have e : (1 : P₄) = pderiv 0 (hPoly 0) := by simp [hPoly, pderiv_X]
    rw [e]
    exact h0
  · have e : (1 : P₄) = (-(1 - 4 * X 1 * X 2 ^ 3)) * pderiv 2 (hPoly 1) +
        (-16 * X 1 ^ 2 * X 2 ^ 2) * pderiv 1 (hPoly 1) := by
      simp [hPoly, pderiv_X]
      ring
    rw [e]
    exact Q.add_mem (Q.mul_mem_left _ h2) (Q.mul_mem_left _ h1)
  · have e : (1 : P₄) = (9 * X 1 ^ 11 * X 2 ^ 2) * hPoly 2 +
        (X 1 ^ 11 * X 2 ^ 2 * X 0) * pderiv 0 (hPoly 2) +
        (-1 - 5 * X 1 ^ 11 * X 2 ^ 3) * pderiv 2 (hPoly 2) := by
      simp [hPoly, pderiv_X]
      linear_combination (-(X 1 ^ 11 * X 2 ^ 2 * X 0 ^ 2 + X 1 ^ 22 * X 2 ^ 6) : P₄) * h11
    rw [e]
    exact Q.add_mem (Q.add_mem (Q.mul_mem_left _ hh) (Q.mul_mem_left _ h0)) (Q.mul_mem_left _ h2)

/-! ## Chart rings as localizations of the hypersurfaces -/

/-- `c` as a polynomial in the ambient coordinates. -/
def cPolyE : Fin 3 → P₄ := ![
  6 * (X 1 * X 2 ^ 3 - 3 * X 1 ^ 4 * X 2 - X 3 ^ 11),
  6 * (X 0 * X 1 ^ 2 * (9 + 9 * X 1 * X 2 ^ 3 + 10 * X 1 ^ 2 * X 2 ^ 6 + 2 * X 1 ^ 3 * X 2 ^ 9) -
    X 3 ^ 11),
  6 * (X 0 * (9 + 9 * X 1 ^ 11 * X 2 ^ 3 + 10 * X 1 ^ 22 * X 2 ^ 6 + 2 * X 1 ^ 33 * X 2 ^ 9) -
    X 3 ^ 11)]

theorem h11L : (11 : L) = 0 := by exact_mod_cast CharP.cast_eq_zero L 11

theorem chartEval_cPolyE (i : Fin 3) : chartEval i (cPolyE i) = cL := by
  fin_cases i
  · simp [cPolyE, chartEval, coordV, cL]
  · simp [cPolyE, chartEval, coordV, yV]
    rw [ρ_pow_B]
    linear_combination cL * h11L
  · simp [cPolyE, chartEval, coordV, yV]
    rw [ρ_pow_D]
    linear_combination cL * h11L

/-- A polynomial in `c`, inside the ambient ring of chart `i`. -/
def cPoly (i : Fin 3) (q : P₁) : P₄ := aeval (fun _ ↦ cPolyE i) q

theorem chartEval_cPoly (i : Fin 3) (q : P₁) :
    chartEval i (cPoly i q) = algebraMap k L (algebraMap P₁ k q) := by
  induction q using MvPolynomial.induction_on with
  | C a =>
    rw [cPoly, aeval_C, AlgHom.commutes, IsScalarTower.algebraMap_apply F₁₁ k L,
      IsScalarTower.algebraMap_apply F₁₁ P₁ k]
    rfl
  | add p q hp hq => simp only [cPoly, map_add] at *; rw [hp, hq]
  | mul_X p j hp =>
    simp only [cPoly, map_mul, aeval_X] at *
    rw [hp, Subsingleton.elim j 0, chartEval_cPolyE, ← algebraMap_c_L]
    rfl

theorem frac_of_adjoin (i : Fin 3) (s : Set L) (hs : ∀ z ∈ s, ∃ p, chartEval i p = z) {z : L}
    (hz : z ∈ Algebra.adjoin k s) :
    ∃ p : P₄, ∃ q : P₁, q ≠ 0 ∧ algebraMap k L (algebraMap P₁ k q) * z = chartEval i p := by
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    obtain ⟨p, rfl⟩ := hs z hz
    exact ⟨p, 1, one_ne_zero, by simp⟩
  | algebraMap r =>
    obtain ⟨u, v, hv, rfl⟩ := IsFractionRing.div_surjective (A := P₁) r
    refine ⟨cPoly i u, v, nonZeroDivisors.ne_zero hv, ?_⟩
    have hv0 : algebraMap P₁ k v ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective P₁ k)).mpr (nonZeroDivisors.ne_zero hv)
    rw [chartEval_cPoly, ← map_mul, mul_div_cancel₀ _ hv0]
  | add a b _ _ ha hb =>
    obtain ⟨p, q, hq, hpq⟩ := ha
    obtain ⟨p', q', hq', hpq'⟩ := hb
    refine ⟨cPoly i q' * p + cPoly i q * p', q * q', mul_ne_zero hq hq', ?_⟩
    simp only [map_add, map_mul, chartEval_cPoly]
    rw [← hpq, ← hpq']
    ring
  | mul a b _ _ ha hb =>
    obtain ⟨p, q, hq, hpq⟩ := ha
    obtain ⟨p', q', hq', hpq'⟩ := hb
    refine ⟨p * p', q * q', mul_ne_zero hq hq', ?_⟩
    simp only [map_mul]
    rw [← hpq, ← hpq']
    ring

/-- Every element of a chart ring is a fraction with a polynomial in `c` as denominator. -/
theorem chartRing_frac (i : Fin 3) (z : L) (hz : z ∈ chartRing i.castSucc) :
    ∃ p : P₄, ∃ q : P₁, q ≠ 0 ∧ algebraMap k L (algebraMap P₁ k q) * z = chartEval i p := by
  fin_cases i
  · refine frac_of_adjoin 0 {aL, bL, σL} ?_ hz
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact ⟨X 1, by simp [chartEval, coordV]⟩
    · exact ⟨X 2, by simp [chartEval, coordV]⟩
    · exact ⟨X 3, by simp [chartEval, coordV]⟩
  · refine frac_of_adjoin 1 {uL, αL, βL, ρL} ?_ hz
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl | rfl
    · exact ⟨X 1, by simp [chartEval, coordV]⟩
    · exact ⟨X 2, by simp [chartEval, coordV]⟩
    · exact ⟨X 0, by simp [chartEval, yV]⟩
    · exact ⟨X 3, by simp [chartEval, coordV]⟩
  · refine frac_of_adjoin 2 {wL, αD, βD, ρL} ?_ hz
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl | rfl
    · exact ⟨X 1, by simp [chartEval, coordV]⟩
    · exact ⟨X 2, by simp [chartEval, coordV]⟩
    · exact ⟨X 0, by simp [chartEval, yV]⟩
    · exact ⟨X 3, by simp [chartEval, coordV]⟩

theorem chartVals_mem (i : Fin 3) (j : Fin 4) : chartVals i j ∈ chartRing i.castSucc := by
  fin_cases i <;> fin_cases j
  exacts [zero_mem _, aL_mem_A, bL_mem_A, σL_mem_A, βL_mem_B, uL_mem_B, αL_mem_B, ρL_mem_B,
    βD_mem_D, wL_mem_D, αD_mem_D, ρL_mem_D]

theorem chartEval_mem (i : Fin 3) (p : P₄) : chartEval i p ∈ chartRing i.castSucc := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [chartEval, aeval_C, IsScalarTower.algebraMap_apply F₁₁ k L]
    exact (chartRing i.castSucc).algebraMap_mem _
  | add p q hp hq => rw [map_add]; exact add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul]
    exact mul_mem hp (by rw [chartEval, aeval_X]; exact chartVals_mem i j)

/-- The evaluation into the chart ring. -/
def chartHom (i : Fin 3) : P₄ →+* chartRing i.castSucc :=
  (chartEval i).toRingHom.codRestrict (chartRing i.castSucc) (chartEval_mem i)

@[simp] theorem coe_chartHom (i : Fin 3) (p : P₄) : (chartHom i p : L) = chartEval i p := rfl

theorem chartHom_cPoly (i : Fin 3) (q : P₁) :
    chartHom i (cPoly i q) = algebraMap k (chartRing i.castSucc) (algebraMap P₁ k q) :=
  Subtype.ext (chartEval_cPoly i q)

theorem isUnit_chartHom_cPoly (i : Fin 3) {q : P₁} (hq : q ≠ 0) :
    IsUnit (chartHom i (cPoly i q)) := by
  rw [chartHom_cPoly]
  exact ((Ne.isUnit ((map_ne_zero_iff _ (IsFractionRing.injective P₁ k)).mpr hq)).map _)

theorem ker_chartHom (i : Fin 3) : RingHom.ker (chartHom i) = Ideal.span {hPoly i} := by
  rw [← ker_chartEval]
  ext p
  simp only [RingHom.mem_ker]
  constructor
  · intro h; simpa using congrArg Subtype.val h
  · intro h; exact Subtype.ext (by simpa using h)

/-! ## Regularity -/

/-- Every local ring of the charts `A`, `B`, `D` is regular. -/
theorem chart_localization_regular (i : Fin 3) (𝔭 : Ideal (chartRing i.castSucc)) [𝔭.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime 𝔭) := by
  set φ := chartHom i
  set Q : Ideal P₄ := 𝔭.comap φ
  set ψ : Localization.AtPrime Q →+* Localization.AtPrime 𝔭 := Localization.localRingHom Q 𝔭 φ rfl
  have hφh : φ (hPoly i) = 0 := Subtype.ext (chartEval_hPoly i)
  have hdom : ∀ {u v : chartRing i.castSucc}, u ≠ 0 → u * v = 0 → v = 0 := fun hu huv ↦
    (mul_eq_zero.mp huv).resolve_left hu
  have hsurj : Function.Surjective ψ := by
    intro z
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl z
    obtain ⟨p, q, hq, hpq⟩ := chartRing_frac i (a : L) a.2
    obtain ⟨p', q', hq', hpq'⟩ := chartRing_frac i (s : chartRing i.castSucc) (s : chartRing i.castSucc).2
    have hpq₁ : φ (cPoly i q) * a = φ p := Subtype.ext (by
      change chartEval i (cPoly i q) * (a : L) = chartEval i p
      rw [chartEval_cPoly]; exact hpq)
    have hpq₂ : φ (cPoly i q') * s = φ p' := Subtype.ext (by
      change chartEval i (cPoly i q') * ((s : chartRing i.castSucc) : L) = chartEval i p'
      rw [chartEval_cPoly]; exact hpq')
    have hden : cPoly i q * p' ∈ Q.primeCompl := by
      change φ (cPoly i q * p') ∉ 𝔭
      rw [map_mul, ← hpq₂]
      intro hmem
      rcases Ideal.IsPrime.mem_or_mem inferInstance hmem with h | h
      · exact (Ideal.IsPrime.ne_top inferInstance)
          (Ideal.eq_top_of_isUnit_mem _ h (isUnit_chartHom_cPoly i hq))
      · rcases Ideal.IsPrime.mem_or_mem inferInstance h with h' | h'
        · exact (Ideal.IsPrime.ne_top inferInstance)
            (Ideal.eq_top_of_isUnit_mem _ h' (isUnit_chartHom_cPoly i hq'))
        · exact s.2 h'
    refine ⟨IsLocalization.mk' _ (p * cPoly i q') ⟨_, hden⟩, ?_⟩
    rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_iff_eq]
    congr 1
    simp only [map_mul, ← hpq₁, ← hpq₂]
    ring
  have hker : RingHom.ker ψ = Ideal.span {algebraMap P₄ (Localization.AtPrime Q) (hPoly i)} := by
    apply le_antisymm
    · intro z hz
      obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
      rw [RingHom.mem_ker, Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hz
      obtain ⟨m, hm⟩ := hz
      have hm0 : (m : chartRing i.castSucc) ≠ 0 := fun h0 ↦ m.2 (h0 ▸ zero_mem _)
      have hr : r ∈ RingHom.ker φ := hdom hm0 hm
      rw [ker_chartHom, Ideal.mem_span_singleton] at hr
      obtain ⟨r', rfl⟩ := hr
      rw [Ideal.mem_span_singleton]
      exact ⟨IsLocalization.mk' _ r' t, (IsLocalization.mul_mk'_eq_mk'_of_mul _ _ _).symm⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      change ψ (algebraMap P₄ _ (hPoly i)) = 0
      rw [Localization.localRingHom_to_map, hφh, map_zero]
  have hm : algebraMap P₄ (Localization.AtPrime Q) (hPoly i) ∈
      maximalIdeal (Localization.AtPrime Q) := by
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q]
    change φ (hPoly i) ∈ 𝔭
    rw [hφh]
    exact zero_mem _
  have hhQ : hPoly i ∈ Q := by
    change φ (hPoly i) ∈ 𝔭
    rw [hφh]
    exact zero_mem _
  obtain ⟨j, hj⟩ : ∃ j : Fin 4, pderiv j (hPoly i) ∉ Q := by
    by_contra h
    push Not at h
    exact (Ideal.IsPrime.ne_top inferInstance)
      ((Ideal.eq_top_iff_one _).mpr (one_mem_of_pderiv i Q hhQ h))
  exact SurfaceLib.isRegularLocalRing_of_surjective ψ hsurj hker hm
    (SurfaceLib.algebraMap_not_mem_maximalIdeal_sq Q (pderiv j) hhQ hj)

/-! ## The point `P₀` of the chart `P`

The chart `P` maps into `S = k'[x', y']`, and `S` is integral over it. The point `P₀` lies under
`x' = y' = 0`. Write `r₀ = x'A₀ + y'B₀` and `r₁ = x'A₁ + y'B₁`; the determinant
`t₀ = A₀B₁ - A₁B₀` has constant term `2`. So `t₀ x', t₀ y' ∈ (r₀, r₁)`, and `t₀¹¹` comes from `P`.
Taking `γ⁰`-components shows that `ξ₀, ξ₁` generate the maximal ideal of the local ring at `P₀`.
-/

def ιSfun (f : chartP) : S₂ := Classical.choose (ι_chartP f.2)

theorem ιSfun_spec (f : chartP) : algebraMap S₂ K' (ιSfun f) = ι f :=
  (Classical.choose_spec (ι_chartP f.2)).symm

/-- The chart `P` inside `S = k'[x', y']`. -/
def ιS : chartP →+* S₂ where
  toFun := ιSfun
  map_one' := IsFractionRing.injective S₂ K' (by simp [ιSfun_spec])
  map_mul' f g := IsFractionRing.injective S₂ K' (by simp [ιSfun_spec])
  map_zero' := IsFractionRing.injective S₂ K' (by simp [ιSfun_spec])
  map_add' f g := IsFractionRing.injective S₂ K' (by simp [ιSfun_spec])

theorem algebraMap_ιS (f : chartP) : algebraMap S₂ K' (ιS f) = ι f := ιSfun_spec f

theorem ιS_eq {f : chartP} {s : S₂} (h : ι f = algebraMap S₂ K' s) : ιS f = s :=
  IsFractionRing.injective S₂ K' (by rw [algebraMap_ιS, h])

theorem ιS_injective : Function.Injective ιS := by
  intro f g h
  apply Subtype.ext
  apply ι.injective
  rw [← algebraMap_ιS, ← algebraMap_ιS, h]

def ξP (n : Fin 11) : chartP := ⟨ξ n, ξ_mem n⟩
def wP : chartP := ⟨wL, wL_mem_P⟩
def aPP : chartP := ⟨aP, aP_mem_P⟩

theorem ιS_ξ (n : Fin 11) : ιS (ξP n) = rK n := ιS_eq (ι_ξ n)

theorem ιS_w : ιS wP = X 1 ^ 2 - X 0 ^ 3 :=
  ιS_eq (by rw [show ι (wP : L) = ι wL from rfl, ι_wL]; simp [wK, xK, yK])

theorem ιS_a : ιS aPP = X 0 ^ 11 :=
  ιS_eq (by rw [show ι (aPP : L) = ι aP from rfl, ι_aP]; simp [xK])

/-- The point `x' = y' = 0` of `S`. -/
def 𝔮₀ : Ideal S₂ := RingHom.ker (constantCoeff : S₂ →+* k')

instance 𝔮₀_isMaximal : 𝔮₀.IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ fun z ↦ ⟨C z, by simp⟩

/-- The point `P₀` of the chart `P`. -/
def 𝔪₀ : Ideal chartP := 𝔮₀.comap ιS

instance 𝔪₀_isPrime : 𝔪₀.IsPrime := Ideal.comap_isPrime ιS 𝔮₀

theorem exists_decomp_of_cc {s : S₂} (hs : constantCoeff s = 0) :
    ∃ A B : S₂, s = X 0 * A + X 1 * B := by
  have hmem : s ∈ Ideal.span (Set.range (X : Fin 2 → S₂)) := by
    rw [← Set.image_univ, mem_ideal_span_X_image]
    intro m hm
    by_contra h
    push Not at h
    have hm0 : m = 0 := by ext i; exact h i (Set.mem_univ i)
    rw [hm0, mem_support_iff, ← constantCoeff_eq] at hm
    exact hm hs
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  refine ⟨c 0, c 1, ?_⟩
  rw [← hc, Fin.sum_univ_two]
  ring

theorem cc_pderiv_zero (A B : S₂) :
    constantCoeff (pderiv 0 (X 0 * A + X 1 * B)) = constantCoeff A := by
  simp [Derivation.leibniz, pderiv_X]

theorem cc_pderiv_one (A B : S₂) :
    constantCoeff (pderiv 1 (X 0 * A + X 1 * B)) = constantCoeff B := by
  simp [Derivation.leibniz, pderiv_X]

theorem two_ne_zero_k' : (2 : k') ≠ 0 := by
  intro h
  have h' : ((2 : ℕ) : k') = 0 := by exact_mod_cast h
  rw [CharP.cast_eq_zero_iff k' 11] at h'
  norm_num at h'

/-- Locally at `P₀`, every element of `𝔪₀` lies in `(ξ₀, ξ₁)`. -/
theorem gen_P₀ (f : chartP) (hf : f ∈ 𝔪₀) :
    ∃ t : chartP, t ∉ 𝔪₀ ∧ t * f ∈ Ideal.span {ξP 0, ξP 1} := by
  obtain ⟨A₀, B₀, h0⟩ := exists_decomp_of_cc (s := rK 0) (by simp [rK, rE, r0])
  obtain ⟨A₁, B₁, h1⟩ := exists_decomp_of_cc (s := rK 1) (by simp [rK, rE, r1])
  have cA₀ : constantCoeff A₀ = 1 := by
    rw [← cc_pderiv_zero A₀ B₀, ← h0]; simp [rK, rE, r0, pderiv_X, map_ofNat]
  have cA₁ : constantCoeff A₁ = 0 := by
    rw [← cc_pderiv_zero A₁ B₁, ← h1]; simp [rK, rE, r1, pderiv_X, map_ofNat]
  have cB₁ : constantCoeff B₁ = 2 := by
    rw [← cc_pderiv_one A₁ B₁, ← h1]; simp [rK, rE, r1, pderiv_X, map_ofNat]
  set t₀ := A₀ * B₁ - A₁ * B₀
  have ct₀ : constantCoeff t₀ = 2 := by simp [t₀, cA₀, cA₁, cB₁]
  obtain ⟨P, Q, hPQ⟩ := exists_decomp_of_cc (s := ιS f) hf
  obtain ⟨t, ht, htι⟩ := frob_mem t₀
  have hιt : ιS ⟨t, ht⟩ = t₀ ^ 11 := ιS_eq (by rw [htι, map_pow])
  refine ⟨⟨t, ht⟩, ?_, ?_⟩
  · change constantCoeff (ιS ⟨t, ht⟩) ≠ 0
    rw [hιt, map_pow, ct₀]
    exact pow_ne_zero _ two_ne_zero_k'
  set U := t₀ ^ 10 * (P * B₁ - Q * A₁)
  set V := t₀ ^ 10 * (Q * A₀ - P * B₀)
  have hkey : ιS (⟨t, ht⟩ * f) = U * rK 0 + V * rK 1 := by
    rw [map_mul, hιt, hPQ, h0, h1]
    simp only [U, V, t₀]
    ring
  obtain ⟨u, hu⟩ := decomp_exists U
  obtain ⟨v, hv⟩ := decomp_exists V
  set tf : L := ((⟨t, ht⟩ * f : chartP) : L)
  have hsum : ∑ i : Fin 11, ι ((if i = 0 then tf else 0) - ((u i : L) * ξ 0 + (v i : L) * ξ 1)) *
      γK ^ (i : ℕ) = 0 := by
    have e1 : ∑ i : Fin 11, ι (if i = 0 then tf else 0) * γK ^ (i : ℕ) = ι tf := by
      rw [Fin.sum_univ_succ]
      simp
    have hterm : ∀ i : Fin 11, ι ((if i = 0 then tf else 0) - ((u i : L) * ξ 0 + (v i : L) * ξ 1)) *
        γK ^ (i : ℕ) = ι (if i = 0 then tf else 0) * γK ^ (i : ℕ) -
        (ι (ξ 0) * (ι (u i) * γK ^ (i : ℕ)) + ι (ξ 1) * (ι (v i) * γK ^ (i : ℕ))) := by
      intro i
      simp only [map_sub, map_add, map_mul]
      ring
    rw [Finset.sum_congr rfl fun i _ ↦ hterm i, Finset.sum_sub_distrib, Finset.sum_add_distrib,
      ← Finset.mul_sum, ← Finset.mul_sum, ← hu, ← hv, e1, ι_ξ, ι_ξ]
    have h2 : ι tf = algebraMap S₂ K' (U * rK 0 + V * rK 1) := by
      rw [← hkey, algebraMap_ιS]
    rw [h2]
    simp only [map_add, map_mul]
    ring
  have hg := decomp_unique _ hsum 0
  simp only [↓reduceIte, sub_eq_zero] at hg
  rw [Ideal.mem_span_pair]
  exact ⟨u 0, v 0, Subtype.ext hg.symm⟩

theorem ξP_mem_zero : ξP 0 ∈ 𝔪₀ := by
  change constantCoeff (ιS (ξP 0)) = 0
  rw [ιS_ξ]
  simp [rK, rE, r0]

theorem ξP_mem_one : ξP 1 ∈ 𝔪₀ := by
  change constantCoeff (ιS (ξP 1)) = 0
  rw [ιS_ξ]
  simp [rK, rE, r1]

theorem maximalIdeal_P₀ : maximalIdeal (Localization.AtPrime 𝔪₀) =
    Ideal.span {algebraMap chartP (Localization.AtPrime 𝔪₀) (ξP 0),
      algebraMap chartP (Localization.AtPrime 𝔪₀) (ξP 1)} := by
  apply le_antisymm
  · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
    intro f hf
    obtain ⟨t, ht, htf⟩ := gen_P₀ f hf
    have hu : IsUnit (algebraMap chartP (Localization.AtPrime 𝔪₀) t) :=
      IsLocalization.map_units _ (⟨t, ht⟩ : 𝔪₀.primeCompl)
    have hmem : algebraMap chartP (Localization.AtPrime 𝔪₀) (t * f) ∈
        Ideal.span {algebraMap chartP (Localization.AtPrime 𝔪₀) (ξP 0),
          algebraMap chartP (Localization.AtPrime 𝔪₀) (ξP 1)} := by
      have := Ideal.mem_map_of_mem (algebraMap chartP (Localization.AtPrime 𝔪₀)) htf
      rwa [Ideal.map_span, Set.image_pair] at this
    rw [Ideal.mem_comap]
    have : algebraMap chartP (Localization.AtPrime 𝔪₀) f =
        ↑hu.unit⁻¹ * algebraMap chartP (Localization.AtPrime 𝔪₀) (t * f) := by
      rw [map_mul, ← mul_assoc, IsUnit.val_inv_mul, one_mul]
    rw [this]
    exact Ideal.mul_mem_left _ _ hmem
  · rw [Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔪₀ _).mpr ξP_mem_zero
    · exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔪₀ _).mpr ξP_mem_one

theorem two_le_height_𝔪₀ : (2 : ℕ∞) ≤ 𝔪₀.height := by
  let f₀ : S₂ →ₐ[k'] MvPolynomial (Fin 1) k' := MvPolynomial.aeval ![0, X 0]
  let 𝔓 : Ideal chartP := (RingHom.ker f₀).comap ιS
  have : (RingHom.ker f₀).IsPrime := RingHom.ker_isPrime _
  have : 𝔓.IsPrime := Ideal.comap_isPrime _ _
  have hlt₁ : (⊥ : Ideal chartP) < 𝔓 := by
    refine bot_lt_iff_ne_bot.mpr fun h ↦ ?_
    have ha : aPP ∈ 𝔓 := by
      change f₀ (ιS aPP) = 0
      rw [ιS_a]
      simp [f₀]
    rw [h] at ha
    exact aP_ne_zero (congrArg Subtype.val (Ideal.mem_bot.mp ha))
  have hcc : (constantCoeff : MvPolynomial (Fin 1) k' →+* k').comp f₀.toRingHom = constantCoeff := by
    apply MvPolynomial.ringHom_ext
    · intro r; simp [f₀]
    · intro i; fin_cases i <;> simp [f₀]
  have hlt₂ : 𝔓 < 𝔪₀ := by
    refine lt_of_le_of_ne (fun z hz ↦ ?_) fun h ↦ ?_
    · change constantCoeff (ιS z) = 0
      have hz' : f₀ (ιS z) = 0 := hz
      rw [← RingHom.congr_fun hcc (ιS z)]
      simp [hz']
    · have hw : wP ∈ 𝔪₀ := by
        change constantCoeff (ιS wP) = 0
        rw [ιS_w]
        simp
      rw [← h] at hw
      change f₀ (ιS wP) = 0 at hw
      rw [ιS_w] at hw
      simp [f₀, X_ne_zero] at hw
  have : (⊥ : Ideal chartP).IsPrime := inferInstance
  have h₁ : (1 : ℕ∞) ≤ 𝔓.height := by
    have h := Ideal.height_add_one_le_of_lt_of_isPrime hlt₁
    exact (by simp : (1 : ℕ∞) ≤ (⊥ : Ideal chartP).height + 1).trans h
  calc (2 : ℕ∞) = 1 + 1 := by norm_num
    _ ≤ 𝔓.height + 1 := by gcongr
    _ ≤ 𝔪₀.height := Ideal.height_add_one_le_of_lt_of_isPrime hlt₂

instance chartP_noetherian : IsNoetherianRing chartP := by
  have h : chartP = (MvPolynomial.aeval ξ : MvPolynomial (Fin 11) k →ₐ[k] L).range := by
    rw [chartP, Algebra.adjoin_range_eq_range_aeval]
  rw [h]
  exact isNoetherianRing_of_surjective _ _ (MvPolynomial.aeval ξ).rangeRestrict.toRingHom
    (AlgHom.rangeRestrict_surjective _)

/-- The local ring at `P₀` is regular. -/
theorem regular_P₀ : IsRegularLocalRing (Localization.AtPrime 𝔪₀) := by
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  have hspan : (maximalIdeal (Localization.AtPrime 𝔪₀)).spanFinrank ≤ 2 := by
    rw [maximalIdeal_P₀]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
    exact (Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton])
  have h3 := @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ 𝔪₀ inferInstance
    (Localization.AtPrime 𝔪₀) _ _ _
  rw [h3]
  have h4 : ((maximalIdeal (Localization.AtPrime 𝔪₀)).spanFinrank : ℕ∞) ≤ 𝔪₀.height :=
    (by exact_mod_cast hspan : ((maximalIdeal (Localization.AtPrime 𝔪₀)).spanFinrank : ℕ∞) ≤ 2).trans
      two_le_height_𝔪₀
  exact_mod_cast h4

/-- `P₀` is the only point of the chart `P` where `w` and `a″` vanish. -/
theorem eq_𝔪₀ (p : Ideal chartP) [hp : p.IsPrime] (hw : wP ∈ p) (ha : aPP ∈ p) : p = 𝔪₀ := by
  let _ : Algebra chartP S₂ := ιS.toAlgebra
  have : Algebra.IsIntegral chartP S₂ := ⟨fun s ↦ by
    obtain ⟨t, ht, htι⟩ := frob_mem s
    have h : ιS ⟨t, ht⟩ = s ^ 11 := ιS_eq (by rw [htι, map_pow])
    refine IsIntegral.of_pow (n := 11) (by norm_num) ?_
    rw [← h]
    exact isIntegral_algebraMap⟩
  have hbot : (⊥ : Ideal S₂).comap (algebraMap chartP S₂) ≤ p := by
    intro z hz
    have hz' : ιS z = 0 := hz
    rw [ιS_injective (hz'.trans (map_zero ιS).symm)]
    exact zero_mem _
  obtain ⟨Q, -, hQ, hQp⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p ⊥ hbot
  have hX0 : (X 0 : S₂) ∈ Q := by
    have h : aPP ∈ Q.under chartP := by rw [hQp]; exact ha
    have h' : ιS aPP ∈ Q := h
    rw [ιS_a] at h'
    exact hQ.mem_of_pow_mem 11 h'
  have hX1 : (X 1 : S₂) ∈ Q := by
    have h : wP ∈ Q.under chartP := by rw [hQp]; exact hw
    have h' : ιS wP ∈ Q := h
    rw [ιS_w] at h'
    have h2 : (X 1 : S₂) ^ 2 ∈ Q := by
      have := Q.add_mem h' (Q.pow_mem_of_mem hX0 3 (by norm_num))
      simpa using this
    exact hQ.mem_of_pow_mem 2 h2
  have hle : 𝔮₀ ≤ Q := by
    intro s hs
    obtain ⟨A, B, rfl⟩ := exists_decomp_of_cc hs
    exact Q.add_mem (Q.mul_mem_right _ hX0) (Q.mul_mem_right _ hX1)
  have hQeq : 𝔮₀ = Q := 𝔮₀_isMaximal.eq_of_le hQ.ne_top hle
  rw [← hQp, ← hQeq]
  rfl

/-! ## Every local ring of `X` is regular -/

theorem away_PA : letI := inclusionAlgebra (show chartP ≤ chartP ⊔ chartA from le_sup_left)
    IsLocalization.Away wP ↥(chartP ⊔ chartA) :=
  subalgebra_isLocalizationAway chartP (chartP ⊔ chartA) le_sup_left wP wL_ne_zero inv_PA
    (sup_le le_sup_left gen_PA)

theorem away_PD : letI := inclusionAlgebra (show chartP ≤ chartP ⊔ chartD from le_sup_left)
    IsLocalization.Away aPP ↥(chartP ⊔ chartD) :=
  subalgebra_isLocalizationAway chartP (chartP ⊔ chartD) le_sup_left aPP aP_ne_zero inv_PD
    (sup_le le_sup_left gen_PD)

/-- A point of chart `i` outside `V(d)`, where the overlap with chart `j` is `ring i[1/d]`, lies
in chart `j`. -/
theorem exists_chart_of_away (i j : atlas.Index) (d : atlas.ring i)
    (hd : letI := inclusionAlgebra (show atlas.ring i ≤ atlas.ring i ⊔ atlas.ring j from le_sup_left)
      IsLocalization.Away d ↥(atlas.ring i ⊔ atlas.ring j))
    (p : PrimeSpectrum (atlas.ring i)) (hp : d ∉ p.asIdeal) :
    ∃ q : PrimeSpectrum (atlas.ring j), atlas.chartInclusion j q = atlas.chartInclusion i p := by
  let _ := inclusionAlgebra (show atlas.ring i ≤ atlas.ring i ⊔ atlas.ring j from le_sup_left)
  haveI := hd
  have hmem : p ∈ Set.range (PrimeSpectrum.comap
      (algebraMap (atlas.ring i) ↥(atlas.ring i ⊔ atlas.ring j))) := by
    rw [PrimeSpectrum.localization_away_comap_range _ d]
    exact hp
  obtain ⟨z, hz⟩ := hmem
  let z' : atlas.overlap i j := z
  have hw := congrArg (fun f ↦ f z') (atlas.overlap_isPullback i j).w
  simp only [Scheme.Hom.comp_apply] at hw
  refine ⟨atlas.left j i (atlas.transition i j z'), ?_⟩
  rw [← hw]
  have hz' : atlas.left i j z' = p := hz
  rw [hz']

/-- Every local ring of `X` is regular. -/
theorem x_stalk_regular (x : X11) : IsRegularLocalRing (X11.presheaf.stalk x) := by
  have hABD (j : Fin 3) (q : PrimeSpectrum (atlas.ring j.castSucc)) :
      IsRegularLocalRing (X11.presheaf.stalk (atlas.chartInclusion j.castSucc q)) := by
    have := @chart_localization_regular j q.asIdeal q.isPrime
    exact @IsRegularLocalRing.of_ringEquiv _ _ this _ _ (atlas.chartStalkEquiv j.castSucc q).symm
  have hP (p : PrimeSpectrum (atlas.ring (3 : Fin 4))) :
      IsRegularLocalRing (X11.presheaf.stalk (atlas.chartInclusion (3 : Fin 4) p)) := by
    by_cases hw : (wP : atlas.ring (3 : Fin 4)) ∈ p.asIdeal
    · by_cases ha : (aPP : atlas.ring (3 : Fin 4)) ∈ p.asIdeal
      · have hp : p.asIdeal = 𝔪₀ := @eq_𝔪₀ p.asIdeal p.isPrime hw ha
        obtain ⟨I, hI⟩ := p
        simp only at hp
        subst hp
        exact @IsRegularLocalRing.of_ringEquiv _ _ regular_P₀ _ _
          (atlas.chartStalkEquiv (3 : Fin 4) ⟨𝔪₀, hI⟩).symm
      · obtain ⟨q, hq⟩ := exists_chart_of_away (3 : Fin 4) (2 : Fin 4) aPP away_PD p ha
        have h := hABD 2 q
        rw [← hq]
        exact h
    · obtain ⟨q, hq⟩ := exists_chart_of_away (3 : Fin 4) (0 : Fin 4) wP away_PA p hw
      have h := hABD 0 q
      rw [← hq]
      exact h
  have key : ∀ (i : Fin 4) (p : PrimeSpectrum (atlas.ring i)),
      IsRegularLocalRing (X11.presheaf.stalk (atlas.chartInclusion i p)) := by
    intro i p
    fin_cases i
    · exact hABD 0 p
    · exact hABD 1 p
    · exact hABD 2 p
    · exact hP p
  obtain ⟨i, p, rfl⟩ := atlas.chartInclusion_cover x
  exact key i p

end

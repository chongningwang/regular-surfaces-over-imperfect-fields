import Geonormal.P11.Constants
import Mathlib.RingTheory.Ideal.GoingUp
import Mathlib.RingTheory.KrullDimension.Polynomial
import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis

/-! # The characteristic-11 surface is two-dimensional

Each chart ring is integral over a `k`-subalgebra generated by two elements:

| chart | generators | integral equations |
|---|---|---|
| `A` | `a, b` | `σ¹¹ = ab³ - 3a⁴b - 2c` |
| `B` | `u, α` | `β² = α + uα⁴`, `ρ¹¹ = βu²(9 + 9uα³ + 10u²α⁶ + 2u³α⁹) - 2c` |
| `D` | `w, α″` | `β″² = α″ + w¹¹α″⁴`, `ρ¹¹ = β″(9 + 9w¹¹α″³ + 10w²²α″⁶ + 2w³³α″⁹) - 2c` |
| `P` | `a″, b″` | `ξ_n¹¹ = r_n(c, a″, b″)` |

A quotient of `k[X, Y]` has dimension at most two, and incomparability bounds each chart. The
elements `a, b` are algebraically independent over `k`, because their images
`x'¹¹/w'⁴, y'¹¹/w'⁶` are independent over `k'`. Going up then lifts the chain `0 ⊂ (a) ⊂ (a, b)`
of `k[a, b]` to chart `A`.
-/

namespace Geonormal.P11

open Red61 Red61.AffineGluing AlgebraicGeometry IsLocalRing

noncomputable section

/-! ## The relations used for integrality -/

theorem ρ_pow_B : ρL ^ 11 = βL * uL ^ 2 * (9 + 9 * uL * αL ^ 3 + 10 * uL ^ 2 * αL ^ 6 +
    2 * uL ^ 3 * αL ^ 9) - 2 * cL := by
  have ha := aL_ne_zero
  have h : ρL ^ 11 = (ρL * aL ^ 3) ^ 11 / aL ^ 33 := by
    rw [eq_div_iff (pow_ne_zero _ ha)]; ring
  rw [h, ρ11]
  simp only [βL, αL]
  field_simp
  ring

theorem ρ_pow_D : ρL ^ 11 = βD * (9 + 9 * wL ^ 11 * αD ^ 3 + 10 * wL ^ 22 * αD ^ 6 +
    2 * wL ^ 33 * αD ^ 9) - 2 * cL := by
  have ha := aL_ne_zero
  have hu := uL_ne_zero
  rw [ρ_pow_B]
  simp only [βD, αD, wL, βL, αL]
  field_simp <;> ring

theorem rE_mem {K : Type*} [CommRing K] (T : Subring K) (n : Fin 11) {g x y : K}
    (hg : g ∈ T) (hx : x ∈ T) (hy : y ∈ T) : rE n g x y ∈ T := by
  have h := rE_map T.subtype n ⟨g, hg⟩ ⟨x, hx⟩ ⟨y, hy⟩
  simp only [Subring.coe_subtype] at h
  rw [← h]
  exact Subtype.prop _

theorem cL_mem (T : Subalgebra k L) : cL ∈ T := algebraMap_c_L ▸ T.algebraMap_mem c

/-! ## `a, b` are algebraically independent over `k` -/

theorem two_le_trdeg_K' : (2 : Cardinal) ≤ Algebra.trdeg k' K' := by
  have h := (MvPolynomial.algebraicIndependent_X (Fin 2) k').map'
    (f := IsScalarTower.toAlgHom k' S₂ K') (IsFractionRing.injective S₂ K')
  simpa using h.cardinalMk_le_trdeg

theorem K'_generation (N : IntermediateField k' K') (hx : xK ∈ N) (hy : yK ∈ N) : N = ⊤ := by
  have hR (p : S₂) : algebraMap S₂ K' p ∈ N := by
    induction p using MvPolynomial.induction_on with
    | C a =>
      rw [← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
      exact N.algebraMap_mem a
    | add p q hp hq => simpa only [map_add] using N.add_mem hp hq
    | mul_X p j hp =>
      rw [map_mul]
      refine N.mul_mem hp ?_
      fin_cases j
      · exact hx
      · exact hy
  rw [eq_top_iff]
  intro z _
  obtain ⟨u, v, -, rfl⟩ := IsFractionRing.div_surjective (A := S₂) z
  exact N.div_mem (hR u) (hR v)

theorem K'_algebraic_ab : Algebra.IsAlgebraic (Algebra.adjoin k' (Set.range ![vK 0, vK 1])) K' := by
  rw [← IntermediateField.isAlgebraic_adjoin_iff_top]
  set M := IntermediateField.adjoin k' (Set.range ![vK 0, vK 1])
  have h0 : vK 0 ∈ M := IntermediateField.subset_adjoin _ _ ⟨0, rfl⟩
  have h1 : vK 1 ∈ M := IntermediateField.subset_adjoin _ _ ⟨1, rfl⟩
  have hw0 := wK_ne_zero
  have hw : wK ∈ M := by
    have h : wK = (vK 1 ^ 2 - vK 0 ^ 3)⁻¹ := by rw [uK_eq, inv_inv]
    rw [h]
    exact M.inv_mem (M.sub_mem (M.pow_mem h1 2) (M.pow_mem h0 3))
  have hx : IsIntegral M xK := by
    have hm : xK ^ 11 ∈ M := by
      rw [show xK ^ 11 = vK 0 * wK ^ 4 by simp only [vK, Matrix.cons_val_zero]; field_simp]
      exact M.mul_mem h0 (M.pow_mem hw 4)
    exact ⟨Polynomial.X ^ 11 - Polynomial.C ⟨_, hm⟩, Polynomial.monic_X_pow_sub_C _ (by norm_num),
      by simp⟩
  have hy : IsIntegral M yK := by
    have hm : yK ^ 11 ∈ M := by
      rw [show yK ^ 11 = vK 1 * wK ^ 6 by
        simp only [vK, Matrix.cons_val_one, Matrix.cons_val_zero]; field_simp]
      exact M.mul_mem h1 (M.pow_mem hw 6)
    exact ⟨Polynomial.X ^ 11 - Polynomial.C ⟨_, hm⟩, Polynomial.monic_X_pow_sub_C _ (by norm_num),
      by simp⟩
  have htop : IntermediateField.adjoin M {xK, yK} = ⊤ := by
    apply IntermediateField.restrictScalars_injective k'
    rw [IntermediateField.adjoin_adjoin_left, IntermediateField.restrictScalars_top]
    exact K'_generation _ (IntermediateField.subset_adjoin _ _ (by simp))
      (IntermediateField.subset_adjoin _ _ (by simp))
  have : FiniteDimensional M (IntermediateField.adjoin M {xK, yK}) :=
    IntermediateField.finiteDimensional_adjoin (by
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hx
      · exact hy)
  rw [htop] at this
  have : FiniteDimensional M K' := IntermediateField.topEquiv.toLinearEquiv.finiteDimensional
  exact Algebra.IsAlgebraic.of_finite M K'

/-- Two elements of each chart over which the chart is integral. -/
def toricGen : Fin 4 → Fin 2 → L := ![![aL, bL], ![uL, αL], ![wL, αD], ![aP, bP]]

/-- The `k`-subalgebra generated by `toricGen i`. -/
def toricRing (i : Fin 4) : Subalgebra k L := Algebra.adjoin k (Set.range (toricGen i))

theorem ab_independent : AlgebraicIndependent k (toricGen 0) := by
  have := K'_algebraic_ab
  have hk' : AlgebraicIndependent k' ![vK 0, vK 1] :=
    (Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite k' ![vK 0, vK 1]
      (by simpa using two_le_trdeg_K')).1
  have hk : AlgebraicIndependent k ![vK 0, vK 1] := hk'.restrictScalars (algebraMap k k').injective
  have he : (ιk ∘ toricGen 0) = ![vK 0, vK 1] := by
    funext j
    fin_cases j
    · show ι aL = vK 0
      rw [ι_aL]; simp [vK]
    · show ι bL = vK 1
      rw [ι_bL]; simp [vK]
  rw [← he] at hk
  exact hk.of_comp ιk

def toricEquiv : MvPolynomial (Fin 2) k ≃ₐ[k] toricRing 0 := ab_independent.aevalEquiv

theorem toricRing_dimension_le (i : Fin 4) : ringKrullDim (toricRing i) ≤ 2 := by
  have h2 : ringKrullDim (MvPolynomial (Fin 2) k) = 2 := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field k]
    norm_num
  rw [← h2, toricRing, Algebra.adjoin_range_eq_range_aeval]
  exact ringKrullDim_le_of_surjective (MvPolynomial.aeval (toricGen i)).rangeRestrict.toRingHom
    (AlgHom.rangeRestrict_surjective _)

/-! ## Charts are integral over their toric rings -/

theorem gen_mem (i : Fin 4) (j : Fin 2) : toricGen i j ∈ toricRing i :=
  Algebra.subset_adjoin ⟨j, rfl⟩

theorem isIntegral_of_mem {T : Subalgebra k L} {z : L} (hz : z ∈ T) : IsIntegral T z :=
  isIntegral_algebraMap (x := (⟨z, hz⟩ : T))

theorem chartA_le_integral : chartA ≤ (integralClosure (toricRing 0) L).restrictScalars k := by
  have ha : aL ∈ toricRing 0 := gen_mem 0 0
  have hb : bL ∈ toricRing 0 := gen_mem 0 1
  have hc := cL_mem (toricRing 0)
  apply Algebra.adjoin_le
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with rfl | rfl | rfl
  · exact isIntegral_of_mem ha
  · exact isIntegral_of_mem hb
  · refine IsIntegral.of_pow (n := 11) (by norm_num) (isIntegral_of_mem ?_)
    rw [σ11]
    subalg_mem

theorem chartB_le_integral : chartB ≤ (integralClosure (toricRing 1) L).restrictScalars k := by
  have hu : uL ∈ toricRing 1 := gen_mem 1 0
  have hα : αL ∈ toricRing 1 := gen_mem 1 1
  have hc := cL_mem (toricRing 1)
  have hβ : IsIntegral (toricRing 1) βL := by
    refine IsIntegral.of_pow (n := 2) (by norm_num) (isIntegral_of_mem ?_)
    rw [βL_sq]
    subalg_mem
  apply Algebra.adjoin_le
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with rfl | rfl | rfl | rfl
  · exact isIntegral_of_mem hu
  · exact isIntegral_of_mem hα
  · exact hβ
  · refine IsIntegral.of_pow (n := 11) (by norm_num) ?_
    rw [ρ_pow_B]
    exact ((hβ.mul (isIntegral_of_mem (by subalg_mem))).mul (isIntegral_of_mem (by subalg_mem))).sub
      (isIntegral_of_mem (by subalg_mem))

theorem chartD_le_integral : chartD ≤ (integralClosure (toricRing 2) L).restrictScalars k := by
  have hw : wL ∈ toricRing 2 := gen_mem 2 0
  have hα : αD ∈ toricRing 2 := gen_mem 2 1
  have hc := cL_mem (toricRing 2)
  have hβ : IsIntegral (toricRing 2) βD := by
    refine IsIntegral.of_pow (n := 2) (by norm_num) (isIntegral_of_mem ?_)
    rw [βD_sq]
    subalg_mem
  apply Algebra.adjoin_le
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with rfl | rfl | rfl | rfl
  · exact isIntegral_of_mem hw
  · exact isIntegral_of_mem hα
  · exact hβ
  · refine IsIntegral.of_pow (n := 11) (by norm_num) ?_
    rw [ρ_pow_D]
    exact (hβ.mul (isIntegral_of_mem (by subalg_mem))).sub (isIntegral_of_mem (by subalg_mem))

theorem chartP_le_integral : chartP ≤ (integralClosure (toricRing 3) L).restrictScalars k := by
  have ha : aP ∈ toricRing 3 := gen_mem 3 0
  have hb : bP ∈ toricRing 3 := gen_mem 3 1
  have hc := cL_mem (toricRing 3)
  apply Algebra.adjoin_le
  rintro _ ⟨n, rfl⟩
  refine IsIntegral.of_pow (n := 11) (by norm_num) (isIntegral_of_mem ?_)
  rw [ξ_pow]
  exact rE_mem (toricRing 3).toSubring n hc ha hb

theorem chart_le_integral (i : Fin 4) :
    chartRing i ≤ (integralClosure (toricRing i) L).restrictScalars k := by
  fin_cases i
  exacts [chartA_le_integral, chartB_le_integral, chartD_le_integral, chartP_le_integral]

theorem toricRing_le (i : Fin 4) : toricRing i ≤ chartRing i := by
  apply Algebra.adjoin_le
  rintro _ ⟨j, rfl⟩
  fin_cases i <;> fin_cases j
  exacts [aL_mem_A, bL_mem_A, uL_mem_B, αL_mem_B, wL_mem_D, αD_mem_D, aP_mem_P, bP_mem_P]

instance (i : Fin 4) : Algebra (toricRing i) (chartRing i) := inclusionAlgebra (toricRing_le i)

instance chart_isIntegral (i : Fin 4) : Algebra.IsIntegral (toricRing i) (chartRing i) := by
  let φ : chartRing i →ₐ[toricRing i] L :=
    { (chartRing i).val with commutes' := fun r ↦ Subalgebra.coe_inclusion (toricRing_le i) r }
  exact ⟨fun z ↦ (isIntegral_algHom_iff φ Subtype.val_injective).mp (chart_le_integral i z.property)⟩

/-! ## Dimension bounds -/

theorem chartRing_dimension_le (i : Fin 4) : ringKrullDim (chartRing i) ≤ 2 := by
  refine le_trans ?_ (toricRing_dimension_le i)
  refine Order.krullDim_le_of_strictMono
    (fun p : PrimeSpectrum (chartRing i) ↦ p.comap (algebraMap (toricRing i) (chartRing i))) ?_
  intro p q hpq
  exact Ideal.IsIntegral.under_lt_under (R := toricRing i) hpq

/-- Chart `A` has a prime of height two, over the chain `0 ⊂ (a) ⊂ (a, b)`. -/
theorem exists_height_two : ∃ Q : Ideal (chartRing 0), Q.IsPrime ∧ 2 ≤ Q.height := by
  let e := toricEquiv.symm.toRingEquiv
  let f₀ : MvPolynomial (Fin 2) k →ₐ[k] MvPolynomial (Fin 1) k :=
    MvPolynomial.aeval ![0, MvPolynomial.X 0]
  let f₁ : MvPolynomial (Fin 1) k →ₐ[k] k := MvPolynomial.aeval ![0]
  let P₀ : Ideal (toricRing 0) := RingHom.ker (f₀.toRingHom.comp e.toRingHom)
  let P₁ : Ideal (toricRing 0) := RingHom.ker ((f₁.comp f₀).toRingHom.comp e.toRingHom)
  have hP₀ : P₀.IsPrime := RingHom.ker_isPrime _
  have hP₁ : P₁.IsPrime := RingHom.ker_isPrime _
  set a : toricRing 0 := e.symm (MvPolynomial.X 0)
  set b : toricRing 0 := e.symm (MvPolynomial.X 1)
  have hea : e a = MvPolynomial.X 0 := e.apply_symm_apply _
  have heb : e b = MvPolynomial.X 1 := e.apply_symm_apply _
  have ha₀ : a ∈ P₀ := by
    rw [RingHom.mem_ker]
    change f₀ (e a) = 0
    rw [hea]
    simp [f₀]
  have ha : a ≠ 0 := by
    intro h
    have := congrArg e h
    rw [hea, map_zero] at this
    exact MvPolynomial.X_ne_zero 0 this
  have hb₁ : b ∈ P₁ := by
    rw [RingHom.mem_ker]
    change f₁ (f₀ (e b)) = 0
    rw [heb]
    simp [f₀, f₁]
  have hb₀ : b ∉ P₀ := by
    rw [RingHom.mem_ker]
    change ¬ f₀ (e b) = 0
    rw [heb]
    simp [f₀, MvPolynomial.X_ne_zero]
  have hle : P₀ ≤ P₁ := fun z hz ↦ by
    rw [RingHom.mem_ker] at hz ⊢
    change f₀ (e z) = 0 at hz
    change f₁ (f₀ (e z)) = 0
    rw [hz, map_zero]
  have hinj : Function.Injective (algebraMap (toricRing 0) (chartRing 0)) :=
    Subalgebra.inclusion_injective (toricRing_le 0)
  have hbot : (⊥ : Ideal (chartRing 0)).under (toricRing 0) ≤ P₀ := by
    intro z hz
    have : algebraMap (toricRing 0) (chartRing 0) z = 0 := hz
    have hz0 : z = 0 := hinj (this.trans (map_zero _).symm)
    rw [hz0]
    exact zero_mem _
  obtain ⟨Q₁, -, hQ₁, hQ₁P⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral P₀ (⊥ : Ideal (chartRing 0)) hbot
  obtain ⟨Q₂, hQ₁₂, hQ₂, hQ₂P⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P₁ Q₁ (hQ₁P ▸ hle)
  have hlt₁ : (⊥ : Ideal (chartRing 0)) < Q₁ := by
    refine bot_lt_iff_ne_bot.mpr fun h ↦ ha ?_
    have : a ∈ Q₁.under (toricRing 0) := hQ₁P ▸ ha₀
    rw [h] at this
    exact hinj ((show algebraMap (toricRing 0) (chartRing 0) a = 0 from this).trans
      (map_zero _).symm)
  have hlt₂ : Q₁ < Q₂ := by
    refine lt_of_le_of_ne hQ₁₂ fun h ↦ hb₀ ?_
    rw [← hQ₁P, h, hQ₂P]
    exact hb₁
  have : (⊥ : Ideal (chartRing 0)).IsPrime := inferInstance
  have h₁ : (1 : ℕ∞) ≤ Q₁.height := by
    have h := Ideal.height_add_one_le_of_lt_of_isPrime hlt₁
    exact (by simp : (1 : ℕ∞) ≤ (⊥ : Ideal (chartRing 0)).height + 1).trans h
  refine ⟨Q₂, hQ₂, ?_⟩
  calc (2 : ℕ∞) = 1 + 1 := by norm_num
    _ ≤ Q₁.height + 1 := by gcongr
    _ ≤ Q₂.height := Ideal.height_add_one_le_of_lt_of_isPrime hlt₂

/-- `X` is a surface. -/
theorem x_dimension : topologicalKrullDim X11 = 2 := by
  apply le_antisymm
  · rw [scheme_dimension_eq_iSup_stalk]
    refine iSup_le fun x ↦ ?_
    obtain ⟨i, p, rfl⟩ := atlas.chartInclusion_cover x
    have := atlas.chartInclusion_open i
    exact (stalk_dimension_le_of_affine_open (CommRingCat.of (atlas.ring i))
      (atlas.chartInclusion i) p).trans (chartRing_dimension_le i)
  · obtain ⟨Q, hQ, h2⟩ := exists_height_two
    let j : atlas.Index := (0 : Fin 4)
    let p : PrimeSpectrum (atlas.ring j) := ⟨Q, hQ⟩
    have h := stalk_dimension_le_scheme X11 (atlas.chartInclusion j p)
    have hp : p.asIdeal.IsPrime := p.isPrime
    have h3 := @IsLocalization.AtPrime.ringKrullDim_eq_height _ _ p.asIdeal hp
      (Localization.AtPrime p.asIdeal) _ _ _
    rw [ringKrullDim_eq_of_ringEquiv (atlas.chartStalkEquiv j p)] at h
    exact (WithBot.coe_le_coe.mpr h2).trans (h3.symm.le.trans h)

end
end Geonormal.P11
